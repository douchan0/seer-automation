# Large binary assets — keep on disk, do not version
artifacts/video/
artifacts/unpacked/
frames/
.pydeps/
.pydeps
__pycache__/
*.pyc
scripts/__pycache__/

# Benchmarks produce a lot of PNGs
bench/results/*.png
bench/tmp/
tmp/
*.log
.DS_Store

# Compiled Swift binaries are rebuilt from source
scripts/seerd
scripts/seerctl
bin/seercap
bin/seerdx

scripts/.cache/
scripts/.tmp/
bench/.cache/

# Swift build products — never version these (257 MB of modulecache leaked in once)
native/.build/
native/.build-*/
native/bin/
.build/
*.swiftmodule
*.pcm
*.o
*.dSYM/

# Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editors / OS
.vscode/
.idea/

# Goal-runner runtime data (local only; never commit account state)
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
data/reports/
data/ai/
data/live_run.log

# MiniMax raw provider transcripts (2.6 MB of JSONL, not a deliverable; the
# human-readable results live in docs/research/mmx/*.md)
docs/research/mmx/logs/

# Battle watchdog snapshots are runtime state (resume points), not source
data/battle/

# Local sqlite backups taken before a manual repair
data/*.sqlite3.bak*

# Raw observation dumps (account state + absolute local paths). The report quotes
# what it needs; these stay local so a public clone carries evidence, not account data.
data/overnight/snapshots/

# Local delivery staging (sandbox cannot write the shared .git)
.delivery/

# Night-run evidence frames stay on disk (4 MB each); the JSONL/MD evidence is versioned
data/overnight/20261106_dual_mode/live/*.png
